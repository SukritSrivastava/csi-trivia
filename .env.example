# Copy to .env.local only if you need to change these. Defaults work for local play.

# Where the browser finds the game server. Default: same computer, port 3001.
# NEXT_PUBLIC_SOCKET_URL=http://192.168.1.5:3001

# Game server settings (read by server/index.ts)
# GAME_PORT=3001
# WEB_PORT=3000
# PUBLIC_WEB_URL=https://your-site.vercel.app
# CORS_ORIGIN=https://your-site.vercel.app
