# Copy to .env.local only if you need to change these. Defaults work for local play.

# Where the browser finds the game server. Default: same computer, port 3001.
# NEXT_PUBLIC_SOCKET_URL=http://192.168.1.5:3001

# Mock game server (mock-server/index.ts)
# GAME_PRESET=demo          # demo or event (or run: npm run dev:event)
# ADMIN_PIN=1234            # quizmaster PIN for /admin
# GAME_PORT=3001
# WEB_PORT=3000
# PUBLIC_WEB_URL=https://your-site.vercel.app
# CORS_ORIGIN=https://your-site.vercel.app

# Results database (game server). Postgres / Supabase connection string, the same
# DATABASE_URL backend/db.js used. Saves rooms, players (scores, ranks, buzzer points)
# and every Round 1 answer (game_history). Leave unset to keep everything in memory.
# DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# Deploying with npm run deploy (docs/DEPLOY.md). Render: Account Settings ? API Keys.
# Vercel: Account Settings ? Tokens.
# RENDER_API_KEY=rnd_...
# RENDER_SERVICE_ID=srv-db5voj7avr4c73a8hes0
# VERCEL_TOKEN=vcp_...
# VERCEL_ORG_ID=team_yNBvrUxFayfHW1pUO6SqAu9f
# VERCEL_PROJECT_ID=prj_7eHriNlOAdmo5tOh9KC3F1LLFLK5
