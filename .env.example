# Hermes Quiz: environment settings.
# Locally: copy what you need into .env.local (git-ignored; .env works too). Defaults work for local play.
# Hosted: put the WEBSITE settings in Vercel (Project → Settings → Environment Variables) and the
# GAME SERVER settings in Render (hermes-quiz-game → Environment). Never commit real values.

# =====================================================================================
# WEBSITE (Vercel / Next.js)
# =====================================================================================

# Where phones, the projector and Admin find the game server. REQUIRED on Vercel: the Render address.
# Locally leave it unset: the page uses the same computer on port 3001 (works for phones on the Wi-Fi).
# It's built into the pages, so redeploy the website after changing it.
# NEXT_PUBLIC_SOCKET_URL=https://hermes-quiz-game.onrender.com

# =====================================================================================
# GAME SERVER (Render / server/index.ts)
# =====================================================================================

# Preset: event (the real night: 20 Round 1 questions, 9 safe, ...) or demo (3 questions, 3 safe). Render: event.
# GAME_PRESET=event

# Quizmaster PIN for /admin and the projector. REQUIRED with GAME_PRESET=event (1234 is refused).
# ADMIN_PIN=choose-a-long-pin

# The website's address: the join link and QR code on the projector. Render: your Vercel address.
# PUBLIC_WEB_URL=https://hermes-quiz-nine.vercel.app

# Browsers allowed to connect (comma-separated). Render: the same Vercel address. Unset = any.
# CORS_ORIGIN=https://hermes-quiz-nine.vercel.app

# Results and the quiz library in Postgres (Supabase → Connect → Session pooler, password filled in).
# Unset (or "off") = quizzes in data/library/ and results in memory (download the CSV from Admin).
# DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-xx.pooler.supabase.com:5432/postgres

# Render only: the Node.js version it builds with (the server needs 22+; tested on 24).
# NODE_VERSION=24

# Render sets PORT by itself. Locally the game server uses GAME_PORT (default 3001).
# GAME_PORT=3001

# -------------------------------------------------------------------------------------
# In-game settings (game server). Each one overrides the preset; unset = the preset's value.
# They are the DEFAULTS every quiz starts with: Admin → a quiz → Settings can still change
# them for that quiz, and "+5 s" adds time during play. "Hermes final quiz" (final_quiz.json) and
# the Demo quiz take the default times on every server start (the final quiz's question counts come
# from the file); quizzes made in Admin keep their own. A bad value stops the game server, naming it.
# The values below are the event preset's.
# -------------------------------------------------------------------------------------
# ROUND1_READ_SECONDS=8          # question on the projector before answers open (Round 1 and wild card)
# ROUND1_ANSWER_SECONDS=8        # time to answer on phones (Round 1 and wild card)
# MULTI_ANSWER_SECONDS=15        # time to answer a multi-correct Round 1 question
# BLACKOUT_READ_SECONDS=5
# BLACKOUT_ANSWER_SECONDS=10
# ROUND1_QUESTIONS=20            # questions played (the rest of the list are spares)
# SAFE_SEATS=9                   # safe at the cut; the wild card adds one more finalist
# WILDCARD_QUESTIONS=5
# WILDCARD_SUDDEN_DEATH_MAX=3
# BLACKOUT_MIN_QUESTIONS=12      # a quiz needs at least this many Blackout questions to open a room
# MIN_PARTICIPANTS=2             # players needed before Start quiz
# MAX_PARTICIPANTS=200

# =====================================================================================
# LOCAL ONLY (never on Render or Vercel)
# =====================================================================================

# GAME_PRESET=event with the default PIN, for a rehearsal on this computer only.
# ALLOW_DEFAULT_PIN=1

# Only used to print the right links in the game server's startup message.
# WEB_PORT=3000

# npm run deploy (docs/DEPLOY.md). Render: Account Settings → API Keys. Vercel: Account Settings → Tokens;
# the org and project ids are in .vercel/project.json after `vercel link`, or the project's Settings.
# RENDER_API_KEY=rnd_...
# RENDER_SERVICE_ID=srv-...
# VERCEL_TOKEN=...
# VERCEL_ORG_ID=team_...
# VERCEL_PROJECT_ID=prj_...
