{
  "name": "hermes-quiz",
  "version": "0.1.0",
  "private": true,
  "description": "Hermes Quiz: a live MCQ quiz for 60–100 people. Questions on the projector, answers on phones, a 6-player buzzer final, run by a quizmaster.",
  "scripts": {
    "dev": "concurrently -k -n web,game -c magenta,cyan \"npm:dev:web\" \"npm:dev:game\"",
    "dev:event": "concurrently -k -n web,game -c magenta,cyan \"npm:dev:web\" \"tsx watch server/index.ts --preset event\"",
    "dev:web": "next dev -H 0.0.0.0 -p 3000",
    "dev:game": "tsx watch server/index.ts",
    "start:game": "tsx server/index.ts",
    "preview": "concurrently -k -n web,game -c magenta,cyan \"next start -H 0.0.0.0 -p 3000\" \"tsx watch server/index.ts\"",
    "build": "next build",
    "start": "concurrently -k -n web,game \"next start -H 0.0.0.0 -p 3000\" \"tsx server/index.ts\"",
    "typecheck": "tsc --noEmit",
    "simulate": "tsx server/simulate.ts",
    "smoke": "tsx scripts/smoke.ts",
    "bots": "tsx scripts/bots.ts",
    "admin-run": "tsx scripts/admin-run.ts",
    "host-shots": "tsx scripts/host-shots.ts",
    "play-shots": "tsx scripts/play-shots.ts",
    "drills": "tsx scripts/drills.ts",
    "rehearsal": "tsx scripts/rehearsal.ts",
    "check-questions": "tsx scripts/check-questions.ts",
    "tune-blackout": "tsx scripts/tune-blackout.ts",
    "check-glow": "tsx scripts/no-glow.ts",
    "washout": "tsx scripts/washout.ts",
    "db-check": "tsx scripts/db-check.ts",
    "deploy": "tsx scripts/deploy.ts"
  },
  "dependencies": {
    "@number-flow/react": "^0.6.2",
    "canvas-confetti": "^1.9.4",
    "motion": "^12.38.0",
    "next": "^16.4.0",
    "pg": "^8.23.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "read-excel-file": "^9.3.12",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.23.15",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.2.1",
    "pg-mem": "^3.0.14",
    "playwright": "^1.64.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
