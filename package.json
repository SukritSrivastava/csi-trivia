{
  "name": "roomful",
  "version": "0.1.0",
  "private": true,
  "description": "A Jackbox-style party game: one shared screen, everyone plays from their phone.",
  "scripts": {
    "dev": "concurrently -k -n web,game -c magenta,cyan \"npm:dev:web\" \"npm:dev:game\"",
    "dev:web": "next dev -H 0.0.0.0 -p 3000",
    "dev:game": "tsx watch server/index.ts",
    "build": "next build",
    "start": "concurrently -k -n web,game \"next start -H 0.0.0.0 -p 3000\" \"tsx server/index.ts\"",
    "typecheck": "tsc --noEmit",
    "simulate": "tsx server/simulate.ts"
  },
  "dependencies": {
    "motion": "^12.23.24",
    "next": "^16.4.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
